/* pages/gr/gr.wxss */

.page-container {
  background-color: #F6F7F9; /* 稍微改淡一点的灰色，更有质感 */
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 150rpx; /* 底部留出更多空间，防止被 TabBar 遮挡 */
  box-sizing: border-box;
}

/* ===========================
   1. 用户信息卡片
   =========================== */
.profile-card {
  background-color: #ffffff;
  border-radius: 24rpx; /* 圆角统一加大 */
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

/* 已登录状态 */
.user-info-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.text-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.username {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.contact {
  font-size: 26rpx;
  color: #999;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 未登录状态 */
.login-prompt-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 120rpx;
}

.login-text {
  font-size: 36rpx;
  color: #007aff;
  font-weight: 500;
  background-color: transparent;
  padding: 0;
  border-radius: 0;
}

/* ===========================
   2. 核心功能区 (大卡片)
   =========================== */
.core-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
}

.core-row {
  display: flex;
  width: 100%;
  justify-content: space-around; /* 均匀分布 */
  align-items: flex-start; /* 顶部对齐 */
  padding: 16rpx 0;
}

.core-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  width: 25%; /* 一行四个 */
}

.core-icon {
  width: 64rpx; /* 稍微调小一点，更精致 */
  height: 64rpx;
  margin-bottom: 12rpx;
}

.core-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 中间分割线 */
.divider {
  width: 92%;
  height: 1rpx;
  background-color: #f5f5f5;
  margin: 10rpx auto;
}

/* ===========================
   3. 列表菜单区 (修复了类名不匹配的问题)
   =========================== */
.menu-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 0 32rpx; /* 左右留白 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.paper-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 30rpx 32rpx;
  border: 2rpx solid #b8d8ce;
  border-radius: 16rpx;
  background-color: #edf7f3;
  box-shadow: 0 4rpx 16rpx rgba(24, 94, 73, 0.06);
}

.paper-entry__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  background-color: #087a60;
  font-size: 32rpx;
  font-weight: 700;
}

.paper-entry__content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.paper-entry__title {
  color: #163d32;
  font-size: 30rpx;
  font-weight: 700;
}

.paper-entry__copy {
  overflow: hidden;
  color: #607a72;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 0; /* 增加高度 */
  border-bottom: 1rpx solid #f7f7f7;
}

/* 最后一个菜单项无下边框 */
.menu-row.no-border {
  border-bottom: none;
}

/* 列表小图标 */
.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
  flex: 1; /* 撑开中间 */
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* 通用点击态 */
.menu-row:active,
.core-item:active,
.paper-entry:active,
.user-info-wrapper:active,
.login-prompt-wrapper:active {
  opacity: 0.7;
  transform: scale(0.99);
}
