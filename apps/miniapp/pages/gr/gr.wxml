<view class="page-container">

<view class="profile-card">
  <block wx:if="{{userInfo}}">
    <view class="user-info-wrapper" bindtap="gotoProfile">
      <view class="text-info">
        <text class="username">{{userInfo.username || '微信用户'}}</text>
        <text class="contact">{{userInfo.phone || '未设置联系方式'}}</text>
      </view>
      <image class="avatar" src="{{userInfo.avatar || defaultAvatar}}" mode="aspectFill"></image>
    </view>
  </block>

  <block wx:else>
    <view class="login-prompt-wrapper" bindtap="handleLogin">
      <text class="login-text">微信登录</text>
    </view>
  </block>
</view>

<view class="core-card">

  <view class="core-row">
    <view class="core-item" bindtap="goToUnlockedList">
      <image class="core-icon" src="/images/icon-order-all.png" mode="aspectFit" />
      <text class="core-text">已解锁</text>
    </view>
    <view class="core-item" bindtap="goToPointDetail">
      <image class="core-icon" src="/images/icon-pay.png" mode="aspectFit" />
      <text class="core-text">积分明细</text>
    </view>

    <view class="core-item" bindtap="goToEarnPoints">
      <image class="core-icon" src="/images/icon-deliver.png" mode="aspectFit" />
      <text class="core-text">赚积分</text>
    </view>
    <view class="core-item" bindtap="goToOrders" data-type="4">
      <image class="core-icon" src="/images/icon-evaluate.png" mode="aspectFit" />
      <text class="core-text">待评价</text>
    </view>
  </view>

  <view class="divider"></view>

  <view class="core-row">
    <view class="core-item" bindtap="navigateTo" data-url="/pages/history/history">
      <image class="core-icon" src="/images/icon-history-color.png" mode="aspectFit" />
      <text class="core-text">历史痕迹</text>
    </view>
    <view class="core-item" bindtap="navigateTo" data-url="/pages/favorites/favorites">
      <image class="core-icon" src="/images/icon-heart-fill.png" mode="aspectFit" />
      <text class="core-text">我的收藏</text>
    </view>
    <block wx:if="{{userInfo.isStudent === 2}}">
      <view class="core-item" bindtap="navigateTo" data-url="/pages/my_products/my_products">
        <image class="core-icon" src="/images/tab-product-active.png" mode="aspectFit" />
        <text class="core-text">我的发布</text>
      </view>
    </block>
    <block wx:else>
      <view class="core-item" bindtap="goToAuth">
        <image class="core-icon" src="/images/scan-icon.png" mode="aspectFit" />
        <text class="core-text">学生认证</text>
      </view>
    </block>
    <view class="core-item"></view>
  </view>

</view>

<view class="paper-entry" bindtap="goToPaperSite">
  <view class="paper-entry__icon">文</view>
  <view class="paper-entry__content">
    <text class="paper-entry__title">论文写作平台</text>
    <text class="paper-entry__copy">前往独立部署的文章生成服务</text>
  </view>
  <text class="arrow">></text>
</view>

<view class="menu-card">
  <view class="menu-row" bindtap="navigateTo" data-url="/pages/guide/guide">
    <image class="menu-icon" src="/images/icon-guide.png" />
    <text class="menu-text">新生宝典</text>
    <text class="arrow">></text>
  </view>

  <view class="menu-row" bindtap="navigateTo" data-url="/pages/newbie/newbie">
    <image class="menu-icon" src="/images/icon-book.png" />
    <text class="menu-text">使用教程</text>
    <text class="arrow">></text>
  </view>

  <view class="menu-row" bindtap="navigateTo" data-url="/pages/feedback/feedback">
    <image class="menu-icon" src="/images/icon-feedback.png" />
    <text class="menu-text">反馈问题</text>
    <text class="arrow">></text>
  </view>

  <view class="menu-row no-border" bindtap="navigateTo" data-url="/pages/about/about">
    <image class="menu-icon" src="/images/icon-about.png" />
    <text class="menu-text">关于我们</text>
    <text class="arrow">></text>
  </view>
</view>

<view style="height: 100rpx;"></view>
</view>
