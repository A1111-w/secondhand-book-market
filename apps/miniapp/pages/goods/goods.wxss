/* pages/goods/goods.wxss */
page {
  background-color: #f7f7f7;
}

.container {
  padding-top: 180rpx; /* 基础顶部空间 */
}

/* --- 1. 顶部搜索栏 --- */
.header-fixed {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 90rpx;
  background: #fff; z-index: 100;
  display: flex; align-items: center; padding: 0 24rpx; box-sizing: border-box;
}
.search-box {
  flex: 1; height: 64rpx; background: #f2f2f2; border-radius: 32rpx;
  display: flex; align-items: center; padding: 0 24rpx;
}
.search-input { flex: 1; margin-left: 12rpx; font-size: 28rpx; color: #333; }

/* --- 2. 排序栏 --- */
.sort-bar {
  position: fixed; top: 90rpx; left: 0; width: 100%; height: 80rpx;
  background: #fff; z-index: 99;
  display: flex; align-items: center; justify-content: space-between; /* 改为 space-between */
  padding: 0 10rpx; box-sizing: border-box;
  border-bottom: 1rpx solid #eee;
}

.sort-item {
  font-size: 26rpx; /* 稍微调小字体以放下5个按钮 */
  color: #333;
  display: flex; align-items: center; justify-content: center;
  height: 100%;
  flex: 1; /* 均分宽度 */
}

.sort-item.active { color: #ff5000; font-weight: bold; }
.filter-wrap.active { color: #ff5000; font-weight: bold; }

.icon-col { display: flex; flexDirection: column; margin-left: 4rpx; line-height: 0.8; }
.arrow { font-size: 12rpx; color: #ccc; }
.arrow.on { color: #ff5000; }
.filter-icon { font-size: 18rpx; margin-left: 4rpx; }

/* --- 【新增】均衡排序滑块面板 --- */
.balance-panel {
  position: fixed;
  top: 170rpx; /* 90 + 80 */
  left: 0; width: 100%;
  background: #fff;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  z-index: 98;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  animation: slideDown 0.2s ease-out;
}
.slider-labels {
  display: flex; justify-content: space-between;
  font-size: 24rpx; color: #666; margin-bottom: 10rpx;
}
@keyframes slideDown {
  from { transform: translateY(-20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* --- 3. 商品列表 --- */
.goods-list { display: grid;   grid-template-columns: repeat(2, 1fr);  gap: 20rpx;  padding: 20rpx; transition: margin-top 0.2s; box-sizing: border-box;}

.goods-card { width: 100%;  background: #fff; border-radius: 16rpx;  overflow: hidden; min-height: 400rpx;  transform: translateY(0);
}
.goods-img { width: 100%; height: 100%; background: #f4f4f4;  display: block; object-fit: cover;
}
.goods-info { padding: 16rpx 16rpx 0; }
.goods-name {
  font-size: 28rpx; color: #333; line-height: 1.4;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.tag {
  display: inline-block; background: linear-gradient(90deg, #ff9000, #ff5000);
  color: #fff; font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx;
  margin-right: 8rpx; vertical-align: middle;
}
.tags-row { margin-top: 12rpx; display: flex; flex-wrap: wrap; }
.sub-tag {
  font-size: 20rpx; color: #ff5000; border: 1rpx solid #ff5000;
  padding: 0 6rpx; border-radius: 4rpx; margin-right: 10rpx;
}
.price-row { margin-top: 16rpx; display: flex; align-items: baseline; justify-content: space-between; }
.price { color: #ff5000; }
.symbol { font-size: 24rpx; font-weight: bold; }
.num { font-size: 36rpx; font-weight: bold; }
.sales { font-size: 22rpx; color: #999; }

.loading-tip, .empty-tip { text-align: center; color: #999; font-size: 24rpx; padding: 30rpx; }
.empty-tip { display: flex; flex-direction: column; align-items: center; padding-top: 100rpx; }
.goods-img-wrapper {
  position: relative;
  width: 100%;
  height: 340rpx;
  overflow: hidden;
}

.sold-out-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.sold-out-mask text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: 2rpx solid #fff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  transform: rotate(-15deg);
}
