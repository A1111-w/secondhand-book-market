/* pages/homepage/homepage.wxss */
.page-container { padding-bottom: 20rpx; }
.search-bar-wrapper {  padding: 16rpx; background-color: #f4f4f4;  display: flex;align-items: center;}
.notice-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background-color: #fffbe6; border: none; margin: 0;  border-radius: 0;color: #d2691e; border-top: 1rpx solid #ffe58f; border-bottom: 1rpx solid #ffe58f;}
.notice-icon { width: 32rpx; height: 32rpx;margin-right: 16rpx; flex-shrink: 0;}
.notice-swiper { flex: 1; height: 40rpx; }
.notice-item {font-size: 26rpx;line-height: 40rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;}
.notice-arrow {font-size: 26rpx;color: #c0c0c0;margin-left: 16rpx;font-weight: bold;}
.image-wrapper {position: relative; width: 220rpx; height: 220rpx;  flex-shrink: 0;   border-radius: 12rpx;  overflow: hidden;      margin-left: 20rpx; }
.scan-icon { width: 48rpx; height: 48rpx; margin-right: 16rpx;}
.search-input { flex: 1;height: 72rpx;  background-color: #fff;  border-radius: 36rpx; padding: 0 30rpx; font-size: 28rpx; }
.search-input { height: 72rpx; background-color: #fff; border-radius: 36rpx; padding: 0 30rpx; font-size: 28rpx; }
.swiper-container { height: 300rpx; }
.swiper-image { width: 100%; height: 100%; }
.filter-bar { display: flex; justify-content: space-between; padding: 20rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.filter-item { padding: 10rpx 20rpx; background: #f5f5f5; border-radius: 12rpx; font-size: 26rpx; }
.sort-popup { position: fixed; bottom: 0; left: 0; width: 100%; background: #fff; z-index: 100; padding: 20rpx; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1); }
.balance-sort { margin: 20rpx 0; padding: 10rpx; border: 1rpx solid #ddd; border-radius: 12rpx; }
.balance-controls { display: flex; justify-content: space-between; align-items: center; flex-wrap: nowrap; }
.balance-controls button { width: 60rpx; height: 40rpx; margin: 0 5rpx; flex-shrink: 0; }
.product-list { padding: 16rpx; }
.product-item {display: flex;border-radius: 16rpx;margin-bottom: 16rpx;box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);position: relative;overflow: hidden;}
.product-info { flex: 1; display: flex;flex-direction: column;margin-right: 20rpx; }
.product-name { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.product-price { color: #FF5733; font-weight: bold;margin-bottom: 12rpx;display: flex;align-items: baseline;  }
/* .product-location { font-size: 24rpx; color: #888; margin-bottom: 10rpx; }旧版 */
.product-location-wrapper {display: flex;flex-direction: row;align-items: center;margin-bottom: 12rpx;}
.location-icon {width: 32rpx;height: 32rpx;margin-right: 10rpx;}
.product-location-text {font-size: 26rpx;color: #4c4c4c; font-weight: 500;}
.product-desc { font-size: 26rpx; color: #666; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.product-image { width: 100%;height: 100%; background-color: #f0f0f0;display: block; }
/* .product-way {font-size: 24rpx;color: #555;margin-bottom: 10rpx;}旧版 */
.tag-way {font-size: 24rpx;color: #4a90e2; background-color: #e6f7ff; border: 1rpx solid #91d5ff;padding: 6rpx 12rpx;border-radius: 8rpx;margin-bottom: 16rpx;align-self: flex-start;font-weight: 500; }
.loading-tip, .empty-tip { text-align: center; color: #999; padding: 20rpx; }
.balance-slider-wrapper {background-color: #fff;padding: 10rpx 30rpx 20rpx;border-bottom: 1rpx solid #f0f0f0;}
.slider-labels {display: flex;justify-content: space-between;font-size: 24rpx;color: #888;margin-bottom: 10rpx;}
.price-currency {font-size: 30rpx;margin-right: 4rpx;}
.price-value {font-size: 42rpx; }
.product-item-hover {transform: translateY(-4rpx) scale(1.01); box-shadow: 0 12rpx 25rpx rgba(0, 0, 0, 0.12); transition: all 0.2s ease; }
.product-content-wrapper {display: flex;flex-direction: row;align-items: flex-start;width: 100%;position: relative; z-index: 2;background-color: rgba(255, 251, 245, 0.8); padding: 20rpx;box-sizing: border-box;}
.product-bg-image {position: absolute; top: 0;left: 0; width: 100%; height: 100%; z-index: 1; opacity: 0.4; object-fit: cover;transform: scale(1.1);}
.sold-out-mask {  position: absolute;  top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); /* 半透明黑色 */ display: flex; justify-content: center;  align-items: center; z-index: 10;}
.sold-out-mask text { color: #fff;  font-size: 32rpx; font-weight: bold; border: 2rpx solid #fff; padding: 4rpx 12rpx; border-radius: 8rpx; transform: rotate(-15deg); /* 稍微歪一点，像盖章 */}
.search-mock { flex: 1; height: 72rpx; background-color: #fff; border-radius: 36rpx;  padding: 0 30rpx; display: flex;align-items: center;}
.search-icon-inline { margin-right: 12rpx;margin-top: 4rpx; }
.search-placeholder { font-size: 28rpx; color: #999;}
