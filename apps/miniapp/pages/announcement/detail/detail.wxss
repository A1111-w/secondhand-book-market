/* pages/announcement/detail/detail.wxss */
.page-container {
  padding: 30rpx;
  background-color: #fff;
  min-height: 100vh;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
}
.author {
  color: #007aff;
  background: #f0f7ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.text-body {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap; /* 关键：保留后端传来的换行符 */
}
.image-area {
  margin-top: 40rpx;
}
.detail-img {
  width: 100%;
  border-radius: 12rpx;
}
.loading {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
}