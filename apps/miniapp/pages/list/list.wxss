 .contain1{
  display: inline-block;  /* 子元素水平排列 */
  width: 100vw;           /* 每条文字占满屏幕宽度 */
  height: 50px;
  text-align: center;     /* 水平居中文字 */
  line-height: 50px;      /* 垂直居中 */
  font-size: 20px;
  background-color: #f0f0f0;
  border-right: 1px solid #ccc;
 }
 .container1{
  width: 100%;
  height: 50px;          /* 容器高度固定 */
  white-space: nowrap;    /* 不换行，保证横向滚动 */
  overflow-x: scroll;     /* 横向滚动显示 */          /* 子元素横向排列 */
 }
 .container1 view:nth-child(7){
  background-color: black;
  color: red;
}

 .item-img{
   width: 100%;/*宽*/
   height: 400px;/*高*/
   border-radius: 10px; /* 角变圆 */
 }

 .myswiper{
   width: 100%;
   height: 400px;
 }

 input{
   border: 1px solid rgb(238, 238, 238);
   padding: 5px;
   margin: 5px;
   border-radius: 3px;
 }

  .lunptu{/*轮播图 */
   width: 400px;/*宽度*/
   height: 400px;/*高度*/
   max-width: 100%;/*最大宽度不超过容器*/
   margin: 0 auto;/*水平居中*/
   padding: 5px;
   border: 1px solid #ccc;
   border-radius: 8px;
   display: block;
 }
