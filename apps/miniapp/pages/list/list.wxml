<swiper class="myswiper"
        indicator-dots="true"
        autoplay="true"
        interval="3000"
        duration="500"
        circular="true">
<swiper-item wx:for="{{swiperList}}" wx:key="id">
  <image class="lunptu" src="{{item.url}}" mode="aspectFill"></image>
</swiper-item>
</swiper>

