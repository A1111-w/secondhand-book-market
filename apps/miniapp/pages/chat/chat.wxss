/* pages/chat/chat.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

/* 滚动区域 */
.message-scroll-view {
  flex: 1; /* 占据所有剩余空间 */
  overflow-y: auto;
  box-sizing: border-box;
  background-color: transparent;
  position: relative;
  z-index: 3;
}

.chat-bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  opacity: 0.75;
}

.chat-bg-blocker {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2; /* 在背景图之上 */

  /* *
   *
   * 让他阻挡滑动行为
   */
  background-color: rgba(0, 0, 0, 0.001);
}

/* 消息列表容器，设置内边距防止被输入框遮挡 */
.message-list {
  padding: 20rpx;
  padding-bottom: 250rpx; /* 底部留出输入框的高度 */
}

.tips-wrapper {
  text-align: center;
  padding: 20rpx 0;
}
.tips-text {
  font-size: 24rpx;
  color: #999;
}

/* 每一条消息 */
.message-item {
  display: flex;
  margin-bottom: 30rpx;
  width: 100%;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0; /* 防止头像被压缩 */
  background-color: #eee;
}

/* 气泡 */
.bubble {
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  max-width: 500rpx; /* 气泡最大宽度 */
  word-break: break-all; /* 自动换行 */
  font-size: 28rpx;
  line-height: 1.5;
}

/* 接收到的消息 (对方发的) */
.message-item.received {
  flex-direction: row; /* 头像在左，气泡在右 */
}
.message-item.received .avatar {
  margin-right: 20rpx;
}
.message-item.received .bubble {
  background-color: #FFFFFF;
  color: #333;
}

/* 发送的消息 (我发的) */
.message-item.sent {
  flex-direction: row-reverse; /* 气泡在左，头像在右 */
}
.message-item.sent .avatar {
  margin-left: 20rpx;
}
.message-item.sent .bubble {
  background-color: #95EC6A;
  color: #000000;
}


/* 底部输入栏 */
.chat-input-bar {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #E0E0E0;
  box-sizing: border-box;
}
.chat-input {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
  min-height: 36rpx; /* 修正输入框高度 */

}
.send-btn {
  flex-shrink: 0;
  margin: 0;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
}
.footer-area {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #F9F9F9;
  z-index: 3;
  padding-bottom: env(safe-area-inset-bottom);
}
.plus-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #7f7f7f;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.plus-icon {
  font-size: 40rpx;
  color: #7f7f7f;
  line-height: 1;
  margin-top: -4rpx; /* 微调垂直居中 */
}
.more-panel {
  height: 200rpx;
  background-color: #F9F9F9;
  border-top: 1rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  gap: 60rpx; /* 图标之间的间距 */
}
.panel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.panel-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
}

.panel-icon {
  width: 50rpx;
  height: 50rpx;
}

.panel-item text {
  font-size: 24rpx;
  color: #666;
}

.product-bubble {
  background: #fff !important;
  padding: 16rpx !important;
  display: flex;
  flex-direction: column;
  width: 400rpx;
  border-radius: 12rpx;
}

.bubble-prod-img {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  background-color: #f4f4f4;
}

.bubble-prod-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  /* 限制显示两行 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bubble-prod-price {
  font-size: 30rpx;
  color: #e44d26;
  font-weight: bold;
}

.guess-bar {
  position: fixed;
  bottom: 130rpx;
  left: 30rpx;
  right: 30rpx;
  height: 100rpx;
  background: #ffffff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 10rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 1000;
  animation: slideUp 0.3s ease-out;
  margin-bottom: env(safe-area-inset-bottom);
  transition: bottom 0.3s ease-in-out;
}


@keyframes slideUp {
  from { transform: translateY(50%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.guess-img { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; border: 2rpx solid #fff;}
.guess-info { flex: 1; display: flex; flex-direction: column; }
.guess-title { font-size: 26rpx; color: #333; font-weight: bold; max-width: 350rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.guess-price { font-size: 24rpx; color: #e44d26; }
.guess-arrow { font-size: 26rpx; color: #007aff; margin-right: 20rpx; font-weight: bold;}
