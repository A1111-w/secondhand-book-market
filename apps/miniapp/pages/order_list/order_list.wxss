/* pages/order_list/order_list.wxss */
.page-container { background-color: #f7f8fa; min-height: 100vh; display: flex; flex-direction: column; }

/* Tabs 优化 */
.tabs { display: flex; background: #fff; padding: 10rpx 20rpx; position: sticky; top: 0; z-index: 10; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02); }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 30rpx; color: #666; font-weight: 500; position: relative; transition: all 0.3s; }
.tab-item.active { color: #333; font-weight: bold; font-size: 32rpx; }
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40rpx; height: 6rpx; background: linear-gradient(90deg, #007aff, #00c6ff); border-radius: 4rpx;
}

/* 列表 */
.list-scroll { flex: 1; padding: 24rpx; box-sizing: border-box; }

.unlock-card {
  background: #fff; border-radius: 24rpx; margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); overflow: hidden;
}

.card-header {
  padding: 24rpx 24rpx 0; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;
}
.order-time { font-size: 24rpx; color: #999; }
.status-text { font-size: 24rpx; font-weight: bold; }
.status-text.pending { color: #ff9000; }
.status-text.done { color: #ccc; }

.card-body { display: flex; padding: 0 24rpx 24rpx; }
.prod-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; margin-right: 24rpx; background: #f4f4f4; flex-shrink: 0; }
.prod-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; height: 140rpx; }
.prod-name { font-size: 30rpx; color: #333; font-weight: bold; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.4; }
.prod-meta { font-size: 24rpx; color: #999; }
.price-row { display: flex; align-items: baseline; }
.currency { font-size: 24rpx; color: #ff5000; font-weight: bold; }
.amount { font-size: 36rpx; color: #ff5000; font-weight: bold; margin-left: 4rpx; }

/* 底部区域 */
.card-footer { background-color: #fafafa; padding: 20rpx 24rpx; border-top: 1rpx solid #f0f0f0; }

.contact-area {
  display: flex; align-items: center; background: #fff; padding: 16rpx 20rpx;
  border-radius: 12rpx; border: 1rpx solid #eee; margin-bottom: 20rpx;
}
.label { font-size: 26rpx; color: #666; }
.value { font-size: 30rpx; color: #333; font-weight: bold; flex: 1; margin: 0 10rpx; }
.copy-icon { width: 32rpx; height: 32rpx; opacity: 0.5; }

.action-row { display: flex; justify-content: flex-end; }
.eval-btn {
  margin: 0 !important; font-size: 26rpx; padding: 0 32rpx; height: 64rpx; line-height: 64rpx;
  background: linear-gradient(90deg, #ff9000, #ff5000); color: #fff; border-radius: 32rpx;
  font-weight: bold; box-shadow: 0 4rpx 12rpx rgba(255, 80, 0, 0.3);
}

.empty-content { padding-top: 200rpx; display: flex; flex-direction: column; align-items: center; color: #999; font-size: 28rpx; }
.empty-img { width: 240rpx; opacity: 0.6; margin-bottom: 20rpx; }