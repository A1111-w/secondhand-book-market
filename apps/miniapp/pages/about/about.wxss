/* pages/about/about.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background-color: #fff;
  padding: 60rpx 40rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.version {
  font-size: 24rpx;
  color: #ccc;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.intro-area {
  background-color: #f9f9f9;
  padding: 40rpx;
  border-radius: 20rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: auto; /* 把 footer 顶到底部 */
}

.intro-text {
  font-size: 28rpx;
  color: #555;
  line-height: 2;
  text-align: justify;
}

.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.footer-info text {
  font-size: 22rpx;
  color: #ccc;
  margin-bottom: 8rpx;
}