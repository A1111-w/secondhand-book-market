<!--pages/points/detail/detail.wxml-->
<view class="container">
  <view class="header-section">
    <view class="header-content">
      <text class="label">当前可用积分</text>
      <text class="num">{{currentPoints}}</text>
      <view class="tips">积分可用于抵扣解锁商品或兑换权益</view>
    </view>
  </view>

  <view class="list-wrapper">
    <view class="list-title">收支明细</view>

    <scroll-view scroll-y class="log-scroll">
      <block wx:if="{{logs.length > 0}}">
        <view class="log-item" wx:for="{{logs}}" wx:key="id">
          <view class="log-info">
            <text class="log-desc">{{item.description}}</text>
            <text class="log-time">{{item.time}}</text>
          </view>
          <view class="log-amount {{item.amount > 0 ? 'income' : 'expense'}}">
            {{item.amount > 0 ? '+' : ''}}{{item.amount}}
          </view>
        </view>
        <view style="height: 60rpx;"></view> </block>

      <view wx:else class="empty-content">
        <image src="/images/empty-box.jpg" mode="widthFix" class="empty-img" />
        <text>暂无积分记录</text>
        <text class="sub-text">快去赚积分吧~</text>
      </view>
    </scroll-view>
  </view>
</view>