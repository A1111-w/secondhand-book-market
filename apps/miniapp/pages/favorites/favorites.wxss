/* pages/favorites/favorites.wxss */
/* 全局背景 */
.page-container {
  background-color: #f7f8fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.title { font-size: 28rpx; font-weight: bold; color: #333; }
.actions { display: flex; gap: 20rpx; }
.sort-btn, .edit-btn { font-size: 26rpx; color: #333; padding: 8rpx 20rpx; background: #f0f0f0; border-radius: 24rpx; }

/* 列表容器 */
.list-container { flex: 1; padding: 20rpx; box-sizing: border-box; }

/* 一级分组 (大卡片) */
.way-group {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.way-header { margin-bottom: 20rpx; }
.way-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx 20rpx 20rpx 8rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
}
.way-tag.pickup { background: linear-gradient(90deg, #ff9a9e, #fad0c4); color: #d64545; }
.way-tag.delivery { background: linear-gradient(90deg, #a18cd1, #fbc2eb); color: #6a4c93; }

/* 二级分组 */
.category-group { margin-bottom: 30rpx; }
.category-header { font-size: 26rpx; color: #666; margin-bottom: 16rpx; font-weight: 500; }
.dot { color: #ddd; margin-right: 8rpx; }

/* 商品条目 */
.product-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  background: #fbfbfb; /* 微弱的背景区分 */
  padding: 16rpx;
  border-radius: 16rpx;
}

/* 复选框样式 */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.checkbox.checked {
  background-color: #007aff;
  border-color: #007aff;
}

/* 商品卡片内容 */
.card-content { flex: 1; display: flex; }
.prod-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; margin-right: 20rpx; background: #eee; }
.prod-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; height: 160rpx; }
.prod-title { font-size: 28rpx; color: #333; font-weight: bold; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.prod-seller { display: flex; align-items: center; font-size: 22rpx; color: #999; }
.seller-avatar { width: 32rpx; height: 32rpx; border-radius: 50%; margin-right: 8rpx; }
.prod-bottom { display: flex; justify-content: space-between; align-items: flex-end; }
.price { color: #ff5000; font-size: 24rpx; }
.price-num { font-size: 36rpx; font-weight: bold; }
.time { font-size: 20rpx; color: #ccc; }

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.select-all { display: flex; align-items: center; font-size: 28rpx; color: #666; }
.total-section { flex: 1; text-align: right; margin-right: 20rpx; }
.total-label { font-size: 26rpx; color: #333; margin-right: 8rpx; }
.total-price { font-size: 36rpx; color: #ff5000; font-weight: bold; }

.action-btn {
  margin: 0;
  padding: 0;
  width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}
.checkout-btn { background: linear-gradient(90deg, #ff9000, #ff5000); }
.delete-btn { background: #fff; color: #ff5000; border: 2rpx solid #ff5000; line-height: 72rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 150rpx; color: #999; font-size: 28rpx; }
.empty-img { width: 300rpx; margin-bottom: 20rpx; opacity: 0.6; }