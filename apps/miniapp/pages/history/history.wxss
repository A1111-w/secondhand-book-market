/* pages/history/history.wxss */
.page-container {
  background-color: #fff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.input-wrapper {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 20rpx;
}
.search-input {
  flex: 1;
  margin: 0 16rpx;
  font-size: 28rpx;
}
.search-btn {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

/* 列表区域 */
.history-list {
  flex: 1;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.date-group {
  margin-bottom: 40rpx;
}

/* 日期头  */
.date-header {
  padding: 30rpx 10rpx;
  display: flex;
  align-items: baseline;
}
.date-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #000;
}

/* 商品网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx; /* 图片之间的间隙 */
}

.grid-item {
  width: 226rpx; /* (750 - 40 - 20) / 3 约等于 230，留点余量 */
  height: 226rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f0f0f0;
}

.prod-img {
  width: 100%;
  height: 100%;
}

/* 价格浮层 */
.prod-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 6rpx 10rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.prod-price {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.prod-status {
  font-size: 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

/* 空状态 */
.empty-state {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}
.empty-img { width: 300rpx; opacity: 0.5; margin-bottom: 20rpx; }