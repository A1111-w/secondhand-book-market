/* 星星文字样式 */
.star-text {
  font-size: 80rpx;       /*以此控制星星大小*/
  line-height: 1;         /* 防止行高撑开额外空间 */
  color: #e0e0e0;         /* 默认灰色 (未选中) */
  transition: all 0.2s;
}

/* 选中状态 (金橙色) */
.star-text.active {
  color: #ffb400;
  text-shadow: 0 4rpx 10rpx rgba(255, 180, 0, 0.4); /* 加点发光效果更像星星 */
  transform: scale(1.1);  /* 选中稍微大一点 */
}

.rating-text {
  font-size: 28rpx;
  color: #ff9000;
  font-weight: bold;
  height: 40rpx;
}

