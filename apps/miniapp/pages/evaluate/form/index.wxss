  font-size: 28rpx;
  color: #ff9000;
  font-weight: bold;
  height: 40rpx; /* 占位防止文字跳动 */
}

/* --- 输入框 --- */
.input-section {
  position: relative;
  background-color: #f9f9f9;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 50rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}
/* 输入框聚焦时高亮边框 */
.input-section:focus-within {
  background-color: #fff;
  border-color: #007aff;
  box-shadow: 0 0 10rpx rgba(0, 122, 255, 0.1);
}

.comment-area {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}
.word-count {
  position: absolute;
  bottom: 20rpx; right: 24rpx;
  font-size: 24rpx; color: #ccc;
}

/* --- 提交按钮 --- */
.submit-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #007aff, #00b4ff);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 122, 255, 0.3);
  padding: 0;
  margin: 0;
  /* 如果希望按钮在最底部，可以使用 margin-top: auto */
  margin-top: auto;
}
.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}