/* components/product-picker/index.wxss */
.picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100; /* 必须比聊天页面的 header 高 */
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s;
}
.picker-mask.show { opacity: 1; visibility: visible; }

.picker-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 70vh; /* 占屏幕高度 70% */
  display: flex;
  flex-direction: column;
}
.picker-content.show { transform: translateY(0); }

.picker-header {
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  position: relative;
  border-bottom: 1rpx solid #eee;
}
.close-icon {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  color: #999;
  font-size: 40rpx;
  line-height: 1;
}

.product-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
  min-height: 500rpx;
  height: 50vh;
}

/* 商品行样式 (仿淘宝) */
.product-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  width: 100%;
}
.prod-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background: #f8f8f8;
  flex-shrink: 0;
}
.prod-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 120rpx;
  margin-right: 20rpx;
  overflow: hidden;
}
.prod-title-row {
  display: flex;
  align-items: center;
}
.tag {
  font-size: 20rpx;
  color: #e44d26;
  border: 1rpx solid #e44d26;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.prod-name {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}
.prod-price {
  font-size: 32rpx;
  color: #e44d26;
  font-weight: bold;
}
.send-btn {
  flex-shrink: 0;
  background: linear-gradient(90deg, #ff8c00, #e44d26);
  color: #fff !important;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 30rpx !important;
  margin: 0 !important;
  height: 60rpx;
  line-height: 60rpx;
  min-width: 100rpx;
  font-weight: normal;
}
.empty-tip { text-align: center; color: #999; margin-top: 100rpx; }